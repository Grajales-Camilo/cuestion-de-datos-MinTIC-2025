# PostgreSQL local para compose.yaml (T-105)
# Copia este archivo como .env en la raiz del repositorio si necesitas
# cambiar usuario, clave, base o puerto. No commits el archivo .env real.

POSTGRES_USER=usuario
POSTGRES_PASSWORD=clave
POSTGRES_DB=cuestion_de_datos
POSTGRES_PORT=5432

# URL equivalente para el backend cuando exista backend/.env (T-102):
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/cuestion_de_datos
