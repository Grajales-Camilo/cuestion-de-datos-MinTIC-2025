# Copiar a .env.local (no versionado) y ajustar según el entorno local.
# Ninguna clave de proveedor (LLM, Socrata, base de datos) pertenece al
# frontend: esas viven exclusivamente del lado del servidor del backend.

# URL del backend FastAPI del núcleo determinista. El navegador se conecta
# directamente a esta URL (sin proxy de Next.js) para REST y SSE.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
