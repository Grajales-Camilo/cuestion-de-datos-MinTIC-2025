# Backend Cuestion de Datos v2.0 (T-102)
# Copia este archivo como backend/.env para desarrollo local.
# No incluyas secretos reales en git.

DATABASE_URL=postgresql://usuario:clave@localhost:5432/cuestion_de_datos
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
SOCRATA_APP_TOKEN=
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
# PENDIENTE T-205: dejar vacio hasta decidir el modelo de embeddings.
EMBEDDING_MODEL=
AGENT_MAX_STEPS=10
RUN_MAX_DURATION_S=600
RUN_HEARTBEAT_TIMEOUT_S=120
WORKER_LEASE_TTL_S=120
DELETE_ACTIVE_GRACE_S=5
RETENTION_USER_DAYS=90
RETENTION_EVAL_MONTHS=24
RETENTION_TECH_MONTHS=12
# Placeholder local no real. En prod/eval usar minimo 32 bytes aleatorios.
RETENTION_HASH_SALT=replace-with-local-development-salt-32-bytes
CATALOG_STALE_AFTER_DAYS=8
PLACEHOLDER_MIN_RATIO=0.30
MAX_CONCURRENT_RUNS=3
CORS_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_TOKEN=
EVAL_MODE=false
